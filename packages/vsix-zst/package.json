{
  "name": "vsix-zst",
  "version": "0.0.1",
  "private": true,
  "description": "Convert VSIX files from zip to tar.zstd",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAP/app-studio-toolkit",
    "directory": "packages/vsix-zst"
  },
  "bin": {
    "vsix-zst": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    ".reuse",
    "LICENSES",
    "README.md",
    "CHANGELOG.md",
    "dist/src/**/*.js",
    "dist/src/**/*.js.map",
    "dist/src/**/*.d.ts"
  ],
  "scripts": {
    "ci": "npm-run-all clean compile coverage",
    "clean": "rimraf ./dist ./coverage ./.nyc_output *.vsix *.vsix.zst",
    "compile": "tsc -p ./",
    "test": "mocha",
    "coverage": "nyc mocha"
  },
  "dependencies": {
    "commander": "14.0.3",
    "tar-stream": "3.2.0",
    "yauzl": "3.4.0",
    "zstd-codec": "0.1.5"
  },
  "devDependencies": {
    "@types/tar-stream": "3.1.4",
    "@types/yauzl": "3.4.0"
  }
}
