{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "listEmittedFiles": false,
    "listFiles": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "outDir": "./dist",
    "removeComments": true,
    "experimentalDecorators": true,
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true,
    "traceResolution": false,
    "declaration": true,
    "skipLibCheck": true,
    "paths": {
      "yeoman-environment/lib/adapter": [
        "./node_modules/@types/yeoman-environment/lib/adapter.d.ts"
      ]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "ts-node": {
    "transpileOnly": true,
    "esm": true
  }
}
