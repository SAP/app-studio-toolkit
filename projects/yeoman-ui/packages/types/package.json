{
  "name": "@sap-devx/yeoman-ui-types",
  "displayName": "yeoman-ui-types",
  "version": "1.25.1",
  "description": "Yeoman-UI prompt types",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAP/app-studio-toolkit.git",
    "directory": "projects/yeoman-ui/packages/types"
  },
  "license": "Apache-2.0",
  "author": "SAP SE",
  "publisher": "SAP",
  "main": "dist/src/index.js",
  "types": "dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "require": "./dist/cjs/src/index.js",
      "import": "./dist/esm/src/index.js",
      "default": "./dist/esm/src/index.js"
    }
  },
  "scripts": {
    "ci": "npm-run-all clean compile",
    "clean": "shx rm -rf ./dist",
    "compile": "npm-run-all compile:tsc esm:mark",
    "compile:tsc": "tsc -b ./tsconfig.json ./tsconfig.cjs.json ./tsconfig.esm.json ./tsconfig.types.json",
    "compile:watch": "tsc -watch",
    "esm:mark": "node -e \"require('fs').writeFileSync('./dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}')\""
  },
  "publishConfig": {
    "access": "public"
  }
}
