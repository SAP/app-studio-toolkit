{
  "name": "@sap-devx/yeoman-ui-types",
  "displayName": "yeoman-ui-types",
  "version": "1.25.1",
  "description": "Yeoman-UI prompt types",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAP/app-studio-toolkit.git",
    "directory": "projects/yeoman-ui/packages/types"
  },
  "license": "Apache-2.0",
  "author": "SAP SE",
  "publisher": "SAP",
  "main": "dist/cjs/src/index.cjs",
  "types": "dist/cjs/src/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/src/index.d.mts",
        "default": "./dist/esm/src/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/src/index.d.cts",
        "default": "./dist/cjs/src/index.cjs"
      }
    }
  },
  "scripts": {
    "ci": "npm-run-all clean compile",
    "clean": "shx rm -rf ./dist",
    "compile": "tsc -b ./tsconfig.json ./tsconfig.cjs.json ./tsconfig.esm.json ./tsconfig.types.json",
    "compile:watch": "tsc -watch"
  },
  "publishConfig": {
    "access": "public"
  }
}
