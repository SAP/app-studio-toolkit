{
  "name": "@sap-devx/yeoman-ui-types",
  "displayName": "yeoman-ui-types",
  "version": "1.25.1",
  "description": "Yeoman-UI prompt types",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAP/app-studio-toolkit.git",
    "directory": "projects/yeoman-ui/packages/types"
  },
  "license": "Apache-2.0",
  "author": "SAP SE",
  "publisher": "SAP",
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "scripts": {
    "ci": "npm-run-all clean compile",
    "clean": "shx rm -rf ./dist",
    "compile": "npm-run-all compile:types compile:esm compile:cjs",
    "compile:types": "tsc",
    "compile:esm": "esbuild ./src/index.ts --outfile=./dist/esm/index.mjs --format=esm --target=es2022 --sourcemap",
    "compile:cjs": "esbuild ./src/index.ts --outfile=./dist/cjs/index.cjs --format=cjs --target=es2022 --sourcemap"
  },
  "devDependencies": {
    "esbuild": "0.25.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
