{
  "name": "@vscode-logging/logger",
  "version": "2.0.10",
  "description": "Logger Library for VSCode Extensions",
  "keywords": [
    "vscode",
    "logger"
  ],
  "files": [
    ".reuse",
    "LICENSES",
    "lib",
    "api.d.ts",
    "CHANGELOG.md",
    "CHANGELOG.old.md"
  ],
  "main": "lib/api.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAP/app-studio-toolkit.git",
    "directory": "projects/vscode-logging/packages/logger"
  },
  "bugs": {
    "url": "https://github.com/SAP/app-studio-toolkit/issues"
  },
  "license": "Apache-2.0",
  "typings": "./api.d.ts",
  "dependencies": {
    "@vscode-logging/types": "workspace:*",
    "fast-safe-stringify": "2.1.1",
    "fs-extra": "11.2.0",
    "lodash": "4.18.1",
    "stacktrace-js": "2.0.2",
    "streamroller": "3.1.5",
    "triple-beam": "1.4.1",
    "winston": "3.11.0",
    "winston-transport": "4.6.0"
  },
  "//@types/vscode": "Pinned to the minimum VS Code API version supported here (kept from the standalone vscode-logging repo). Intentionally not raised to the monorepo root version, which would allow newer APIs and break support for older VS Code.",
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/vscode": "1.51.0",
    "chai-exclude": "2.1.0",
    "proxyquire": "2.1.3",
    "sinon": "17.0.1",
    "sinon-chai": "3.7.0"
  },
  "scripts": {
    "ci": "npm-run-all type-check coverage:*",
    "test": "mocha \"./test/**/*spec.js\"",
    "coverage:run": "nyc mocha \"./test/**/*spec.js\"",
    "coverage:check": "nyc check-coverage --lines 100 --branches 100 --statements 100 --functions 100",
    "type-check": "tsc"
  },
  "publishConfig": {
    "access": "public"
  }
}
